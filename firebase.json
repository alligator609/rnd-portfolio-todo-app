{
  "hosting": {
    "site": "codewithzia",
    "public": "dist/todo/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.csr.html"
      }
    ],
    "appAssociation": "AUTO",
    "mainFile": "index.csr.html"
  }
}